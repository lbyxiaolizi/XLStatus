# Copy to .env before running docker compose on a remote host.
#
# Generate both secrets once before the first Compose start and preserve them
# across upgrades. For example: openssl rand -hex 32
SESSION_SECRET=
POSTGRES_PASSWORD=

# For remote Docker Compose deployment, use addresses reachable from the user's browser.
# Do not put the seed admin password in this file. Compose reads it from:
#   .secrets/xlstatus_seed_admin_password

# Example: http://example.com:8080
XLSTATUS_PUBLIC_API_URL=

# Example: http://example.com:3000,http://localhost:3000,http://127.0.0.1:3000
XLSTATUS_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Host address used to publish Agent gRPC. Loopback is the safe default.
# Only set 0.0.0.0 when remote Agents connect through TLS/mTLS or a trusted VPN.
XLSTATUS_GRPC_PUBLISH_ADDRESS=127.0.0.1
